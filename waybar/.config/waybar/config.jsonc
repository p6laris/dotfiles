{
  "layer": "top",
  "position": "top",
  "margin": 0,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "network", "pulseaudio", "battery"],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name} {windows}",
    "format-window-separator": "  ",
    "window-rewrite-default": "",
    "window-rewrite": {
      "title<.*youtube.*>": "",
      "class<firefox>": "󰈹",
      "class<kitty>": "",
      "class<dolphin>": "󰉋",
      "class<code.*>": "󰨞",
      "class<discord>": "",
      "class<spotify>": "",
      "class<.*steam.*>": ""
    },
    "persistent-workspaces": {
      "*": 5
    }
  },
  "hyprland/window": {
    "format": "{title}",
    "rewrite": {
      "": "<span color='#6c7086'>Null</span>"
    },
    "max-length": 45
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "clock": {
    "format": "<span color='#eba0ac'> </span> {:%I:%M %p}",
    "format-alt": "<span color='#eba0ac'> </span> {:%A, %B %d, %Y (%R)}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "<span color='#a6e3a1'>{icon}</span>  {capacity}%",
    "format-charging": "<span color='#94e2d5'></span>  {capacity}%",
    "format-plugged": "<span color='#94e2d5'></span>  {capacity}%",
    "format-alt": "<span color='#a6e3a1'>{icon}</span>  {time}",
    "format-icons": ["", "", "", "", ""]
  },
  "network": {
    "format-wifi": "<span color='#74c7ec'> </span>  {essid}",
    "format-ethernet": "<span color='#74c7ec'>󰈀 </span>  {ipaddr}",
    "format-disconnected": "<span color='#f38ba8'>⚠ </span>  Disconnected",
    "format-alt": "{ifname}: {ipaddr}/{cidr}"
  },
  "pulseaudio": {
    "format": "<span color='#fab387'>{icon}</span>  {volume}%",
    "format-bluetooth": "<span color='#fab387'>{icon}</span> {volume}%",
    "format-muted": "<span color='#a6adc8'> </span> Muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    }
  }
}
